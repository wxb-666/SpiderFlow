# MySQL 容器初始化配置，仅用于本地开发。
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_DATABASE=spiderflow
MYSQL_USER=spiderflow
MYSQL_PASSWORD=spiderflow_dev_password
MYSQL_PORT=3306

# 应用连接与运行配置。
DB_HOST=mysql
DB_PORT=3306
APP_TIMEZONE=Asia/Shanghai

# APScheduler 工作日运行时间（24 小时制）。
SCHEDULE_HOUR=17
SCHEDULE_MINUTE=0
